{
    "name": "bynn/decisionnode",
    "description": "PHP client for the DecisionNode API: ask yes-or-no, choice and score questions about any input and get calibrated probabilities back.",
    "type": "library",
    "license": "MIT",
    "keywords": ["decisionnode", "decision", "classification", "scoring", "api", "sdk"],
    "homepage": "https://decisionnode.com",
    "authors": [
        {
            "name": "Bynn Intelligence, Inc.",
            "homepage": "https://decisionnode.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/promises": "^2.0",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bynn\\DecisionNode\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bynn\\DecisionNode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "conformance": "phpunit --testsuite conformance",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
